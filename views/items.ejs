<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="header"><h1>Наши изделия</h1></div>
    <div class="container">
        <div class="add-panel">
            <input type="text" id="nameInp" placeholder="Название">
            <input type="number" id="priceInp" placeholder="Цена">
            <button id="addBtn" class="main-btn">Добавить</button>
        </div>
        
        <% items.forEach(item => { %>
            <div class="card" data-id="<%= item.id %>">
                <div class="card-icons">
                    <span class="edit-icon">✏️</span>
                    <span class="delete-icon">❌</span>
                </div>
                <h2><%= item.name %></h2>
                <p><%= item.price %> ₽</p>
            </div>
        <% }) %>
    </div>
    <div class="controls-panel">
    <form action="/view-items" method="GET" class="filter-form">
        <input type="text" name="search" placeholder="Поиск по названию..." value="<%= search %>">
        <select name="sort">
            <option value="">Без сортировки</option>
            <option value="asc" <%= sort === 'asc' ? 'selected' : '' %>>А-Я ↑</option>
            <option value="desc" <%= sort === 'desc' ? 'selected' : '' %>>Я-А ↓</option>
        </select>
        <button type="submit" class="main-btn">Применить</button>
    </form>
    <a href="/chat" class="main-btn">Перейти в онлайн-чат</a>
</div>

<div class="items-list"> ... </div>

<div class="pagination">
    <% for(let i = 1; i <= totalPages; i++) { %>
        <a href="/view-items?page=<%= i %>&search=<%= search %>&sort=<%= sort %>" 
           class="page-link <%= i === currentPage ? 'active' : '' %>">
           <%= i %>
        </a>
    <% } %>
</div>  
    <script src="/app.js"></script>
</body>
</html>