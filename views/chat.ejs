<div class="chat-wrapper">
    <!-- Слой 1: Ввод имени -->
    <div id="login-screen">
        <input type="text" id="username" placeholder="Введите ваше имя...">
        <button onclick="joinChat()">Войти в чат</button>
    </div>

    <div id="chat-screen" style="display:none;">
        <div style="display:flex;">
            <div id="chat-box" style="width:80%; height:300px; border:1px solid #ccc; overflow-y:auto;"></div>
            <div id="users-box" style="width:20%; border:1px solid #eee; padding-left:10px;">
                <b>В сети:</b>
                <ul id="online-list"></ul>
            </div>
        </div>
        <input type="text" id="msg" placeholder="Сообщение...">
        <button onclick="sendMessage()">Отправить</button>
    </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
    const socket = io();
    
    function joinChat() {
        const name = document.getElementById('username').value;
        if (name) {
            socket.emit('set-username', name); 
            document.getElementById('login-screen').style.display = 'none';
            document.getElementById('chat-screen').style.display = 'block';
        }
    }

    function sendMessage() {
        const msg = document.getElementById('msg').value;
        if (msg) {
            socket.emit('send-message', msg); 
            document.getElementById('msg').value = '';
        }
    }

    socket.on('message', (data) => {
        const item = document.createElement('div');
        item.innerHTML = `<b>${data.user}:</b> ${data.text}`;
        document.getElementById('chat-box').appendChild(item);
    });

    socket.on('user-list', (names) => {
        const list = document.getElementById('online-list');
        list.innerHTML = names.map(n => `<li>${n}</li>`).join('');
    });
</script>